{
  "name": "camille-web-monorepo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "bun run dev:app",
    "dev:app": "bun run --cwd apps/app dev",
    "dev:marketing": "bun run --cwd apps/marketing dev",
    "build": "turbo run build",
    "build:app": "bun run --cwd apps/app build",
    "build:marketing": "bun run --cwd apps/marketing build",
    "start": "bun run start:app",
    "start:app": "bun run --cwd apps/app start",
    "start:marketing": "bun run --cwd apps/marketing start",
    "check": "bun run typecheck && bun run lint && bun run test",
    "typecheck:app": "bun run --cwd apps/app typecheck",
    "typecheck:marketing": "bun run --cwd apps/marketing typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:api": "bun run --cwd apps/app test:e2e:api",
    "test:e2e": "bun run --cwd apps/app test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "build:all": "bun run build:app && bun run build:marketing",
    "deploy:why": "node ./scripts/netlify-ignore-build.mjs",
    "typecheck:shared": "bun run --cwd packages/shared typecheck"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@blocknote/core": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@blocknote/shadcn": "^0.51.4",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "ahooks": "^3.9.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ky": "^2.0.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@dauphaihau/eslint-config": "^0.3.4",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-tailwindcss": "^4.0.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "msw": "^2.14.6",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "turbo": "^2.10.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
